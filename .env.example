# ==============================================================================
# ExpressJS-Kafka-Producer-Consumer-POC - environment variables
# Copy this file to ".env" and fill in real values for local development.
# Nothing in this file is a real secret - see SETUP_GUIDE.md.
# ==============================================================================

# ---- Server ----
PORT=8082
NODE_ENV=development

# ---- CORS (comma-separated origins allowed to call this API from a browser) ----
ITEM_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Kafka ----
ITEM_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ITEM_KAFKA_TOPIC=Item_Topic
ITEM_KAFKA_CLIENT_ID=item-kafka-producer-poc
ITEM_KAFKA_CONSUMER_GROUP=item_group
ITEM_KAFKA_MANUAL_CONSUMER_GROUP=manual-item-group

# ---- Source database (defaults to MySQL so the POC works without SQL Server) ----
# Set ITEM_SOURCE_DB_TYPE=mssql to read from real SQL Server instead.
ITEM_SOURCE_DB_TYPE=mysql
ITEM_MYSQL_SOURCE_HOST=localhost
ITEM_MYSQL_SOURCE_PORT=3306
ITEM_MYSQL_SOURCE_DB=item_poc_source
ITEM_MYSQL_SOURCE_USERNAME=root
ITEM_MYSQL_SOURCE_PASSWORD=change-me
ITEM_MYSQL_SOURCE_TABLE=ITEM

# ---- MS SQL Server source (only used when ITEM_SOURCE_DB_TYPE=mssql) ----
ITEM_MSSQL_HOST=localhost
ITEM_MSSQL_PORT=1433
ITEM_MSSQL_DB=item_poc_source
ITEM_MSSQL_USERNAME=sa
ITEM_MSSQL_PASSWORD=change-me
ITEM_MSSQL_SOURCE_TABLE=ITEM
ITEM_MSSQL_ENCRYPT=false
ITEM_MSSQL_TRUST_SERVER_CERT=true

# ---- Sink database (written to by the Kafka -> MySQL streaming job) ----
ITEM_MYSQL_HOST=localhost
ITEM_MYSQL_PORT=3306
ITEM_MYSQL_DB=item_poc
ITEM_MYSQL_USERNAME=root
ITEM_MYSQL_PASSWORD=change-me
ITEM_MYSQL_TABLE=ITEM

# ---- JWT (used by the gateway message-routing demo) ----
ITEM_JWT_PRIVATE_KEY=
ITEM_JWT_ISSUER=item-kafka-producer
ITEM_JWT_EXPIRY_MINUTES=30

# ---- Downstream gateway (JWT-signed demo call) ----
ITEM_GATEWAY_URL=http://localhost:8081/item-kafka/app/send-items/v1

# ---- Streaming-job tuning (Node.js equivalent of Flink's batch sink options) ----
ITEM_JOB_BATCH_SIZE=1000
ITEM_JOB_BATCH_INTERVAL_MS=200
ITEM_JOB_MAX_RETRIES=3

# ---- Logging ----
LOG_LEVEL=info

