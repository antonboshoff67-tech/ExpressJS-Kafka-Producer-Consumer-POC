  },
  "keywords": [
    "express",
    "nodejs",
    "kafka",
    "kafkajs",
    "flink",
    "mysql",
    "mssql",
    "sql-server",
    "jwt",
    "swagger",
    "poc"
  ],
  "author": "Anton Boshoff",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "mssql": "^11.0.1",
    "mysql2": "^3.12.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5",
    "winston": "^3.17.0"
  },
